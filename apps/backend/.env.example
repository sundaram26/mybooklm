PORT=4000
DATABASE_URL="postgresql://postgres:password@localhost:5432/notebooklm"
QDRANT_URL="http://localhost:6333"

# Better Auth Configuration (Generate a secure random string for the secret)
BETTER_AUTH_SECRET="your_secure_random_secret_here"
BETTER_AUTH_API_KEY="your_better_auth_api_key_here"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers (Create these in Google/GitHub developer consoles)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"

# LLM Providers
OPENAI_API_KEY="your_openai_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# Model Tier Configurations
MINI_PROVIDER="google"
MINI_MODEL="gemini-2.0-flash"
MEDIUM_PROVIDER="openai"
MEDIUM_MODEL="gpt-4o-mini"
HIGH_PROVIDER="openai"
HIGH_MODEL="gpt-4o"

# Backblaze B2 / AWS S3 Cloud Storage Configuration
BACKBLAZE_B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
AWS_S3_BUCKET="your_s3_bucket_name_here"
AWS_ACCESS_KEY_ID="your_aws_access_key_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key_here"
AWS_REGION="us-east-005"

# Redis Server URL (Used by BullMQ for background jobs)
REDIS_URL="redis://127.0.0.1:6379"
